# ──────────────────────────────────────────────────────────────────────
# REAL TRY ON — environment template
# Copy to .env and fill in values. `shopify app dev` injects the SHOPIFY_*
# vars automatically; the rest you set yourself.
# ──────────────────────────────────────────────────────────────────────

# Shopify app credentials (auto-injected by `shopify app dev`)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_products,write_metaobjects,write_metaobject_definitions

# Postgres
DATABASE_URL=postgresql://user:pass@localhost:5432/realtryon

# Cloudflare R2 (S3-compatible) — for shopper photo uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=realtryon-uploads

# AI providers (at least one; otherwise the engine falls back to mock)
FASHN_API_KEY=
FASHN_API_URL=https://api.fashn.ai/v1
REPLICATE_API_TOKEN=

# Image upload limits
MAX_IMAGE_SIZE_MB=10

# Billing — set to "false" in production to charge real money. Default test mode.
SHOPIFY_BILLING_TEST=true

# Optional — set if shops use a custom storefront domain (not *.myshopify.com).
SHOP_CUSTOM_DOMAIN=
